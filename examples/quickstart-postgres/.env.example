# Loams Postgres on loopback (the release's loams-postgres-dev stack), or over a tailnet.
# Never a public endpoint.
DATABASE_URL=postgresql://cloud_admin:cloud_admin@127.0.0.1:55433/postgres

# The model and embedder, as Mastra model-router ids. Leave both unset to run the demo
# offline with a mock model and a local embedder.
# MODEL=openai/gpt-5-mini
# EMBEDDER=openai/text-embedding-3-small
# OPENAI_API_KEY=

{
  "name": "@loams/mastra-acp",
  "version": "0.0.0",
  "private": false,
  "description": "Serve a Mastra agent over the Agent Client Protocol (ACP), so ACP clients such as Loams Studio run it as a harness",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0"
  },
  "devDependencies": {
    "@mastra/core": "1.78.0",
    "@types/node": "24.19.2",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.78.0-0 <2.0.0-0"
  },
  "homepage": "https://github.com/ostrium-labs/loams-mastra/tree/main/packages/acp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrium-labs/loams-mastra.git",
    "directory": "packages/acp"
  },
  "bugs": "https://github.com/ostrium-labs/loams-mastra/issues",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

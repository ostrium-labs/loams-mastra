  },
  "devDependencies": {
    "@loams-internal/upstream-inngest-workflow-test-utils": "workspace:*",
    "@loams/mastra-resonate": "workspace:*",
    "@mastra/core": "1.78.0",
    "@mastra/libsql": "1.26.2",
    "@resonatehq/sdk": "0.11.5",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}

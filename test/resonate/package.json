{
  "name": "@loams-internal/resonate-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Integration tests of @loams/mastra-resonate against a real Resonate server: upstream Resonate or Loams Durable",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",

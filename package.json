{
  "name": "loams-mastra",
  "private": true,
  "type": "module",
  "description": "Loams × Mastra: one backend for Mastra memory, workflows, observability and vectors.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run --root . scripts && pnpm -r --if-present test",
    "check:pins": "node scripts/check-pins.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
